<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html, /index, or /index/ to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(?:\.html)?\ HTTP/ [NC]
  RewriteRule ^index(?:\.html)?$ / [R=301,L]

  # Redirect legacy blog routes
  RewriteRule ^all-articles(?:\.html)?$ /blogs [R=301,L]
  RewriteRule ^blog\.html$ /blogs [R=301,L]

  # Redirect /path.html to /path (excluding animations)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /((?!animations/).+)\.html(\?.*)?\ HTTP/ [NC]
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # Internal rewrite: Clean URL to .html if file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Internal rewrite: /blogs -> blogs.html
  RewriteRule ^blogs/?$ blogs.html [L]

  # Internal rewrite: /blog/:slug -> blog.html
  RewriteRule ^blog/[^/]+/?$ blog.html [L]
</IfModule>
