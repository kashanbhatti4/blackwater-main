# ==========================================
# Blackwater Digital - Environment Variables
# ==========================================

# Server Configuration
PORT=3000
APP_URL=http://localhost:3000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blackwater_blog
DB_CONNECTION_LIMIT=10

# Security & Admin Authentication
# IMPORTANT: Generate a strong, random 64-character secret in production!
JWT_SECRET=change_this_to_a_random_secure_secret_key_in_production

# Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_DIR=public/uploads/blogs

# Resend Email Configuration (Contact Form)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Blackwater Digital <notifications@blackwaterdigital.ie>
CONTACT_TO_EMAIL=info@blackwaterdigital.ie

# Cloudflare Turnstile (bot protection on the contact form, audit form and admin sign in)
# Both keys come from Cloudflare dashboard > Turnstile. Leave blank to turn the check off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Reviews Widget (hero + footer rating and review count)
# Leave blank to fall back to GOOGLE_REVIEWS_RATING / GOOGLE_REVIEWS_COUNT
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_REVIEWS_RATING=5.0
GOOGLE_REVIEWS_COUNT=8
